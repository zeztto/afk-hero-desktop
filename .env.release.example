# Optional macOS release signing/notarization environment.
# Do not commit real values.

# Developer ID Application certificate. electron-builder can also read CSC_NAME
# from the local keychain when the certificate is installed.
CSC_NAME=

# Preferred App Store Connect API key flow for notarization.
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=

# Alternative Apple ID flow.
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
